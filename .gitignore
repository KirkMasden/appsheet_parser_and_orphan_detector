# sheet_capture.gs output, if a downloaded dump ever ends up near the repo
# instead of the sibling sheet_dumps/ folder — these carry a workbook's
# raw formulas and values and must never be tracked.
*_formulas_*.json
*_values_*.json

# sheet_derivation tool output, if a run is ever pointed at a path inside
# the repo instead of the sibling sheet_derivation_output/ folder — derived
# artifacts are built from private capture data and must never be tracked.
sheet_derivation_output/
